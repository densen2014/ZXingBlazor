@page "/"
@page "/en"
@page "/barcodereader"
@inject NavigationManager NavigationManager

<section class="hero">
    <div class="hero-copy">
        <div class="hero-topline">
            <span class="version-pill">.NET 6—10</span>
            <span>@L("适用于 Blazor WebAssembly 与 Server", "For Blazor WebAssembly and Server")</span>
        </div>
        <h1>@L("让 Blazor 扫码更简单", "Barcode scanning, made simple for Blazor")</h1>
        <p class="hero-lead">
            @L("直接调用浏览器摄像头识别一维码与二维码。支持设备切换、连续解码、反色识别和扫码截图，无需手动引入 JavaScript。",
               "Scan 1D and 2D barcodes directly from the browser camera. Device switching, continuous decoding, inverted codes, and scan-frame capture work without manual JavaScript setup.")
        </p>
        <div class="hero-actions">
            <a class="btn btn-primary btn-lg" href="#demo">@L("在线体验", "Try it live")</a>
            <a class="btn btn-light btn-lg" href="#quick-start">@L("快速上手", "Quick start")</a>
        </div>
    </div>
    <button class="language-button" type="button" @onclick="ToggleLanguage"
            aria-label="@L("Switch to English", "切换到中文")">
        <span class="oi oi-globe" aria-hidden="true"></span>
        @(IsEnglish ? "中文" : "English")
    </button>
</section>

<section id="features" class="content-section">
    <div class="section-intro">
        <span class="section-kicker">@L("核心能力", "Core capabilities")</span>
        <h2>@L("一个组件，覆盖完整扫码流程", "One component for the complete scanning flow")</h2>
        <p>@L("从摄像头授权到结果回调，常见扫码场景都有清晰、类型安全的 Blazor API。",
             "From camera permission to result callbacks, common scanning scenarios are covered by clear, type-safe Blazor APIs.")</p>
    </div>

    <div class="feature-grid">
        @foreach (var feature in Features)
        {
            <article class="feature-card">
                <span class="feature-icon oi @feature.Icon" aria-hidden="true"></span>
                <h3>@L(feature.ZhTitle, feature.EnTitle)</h3>
                <p>@L(feature.ZhDescription, feature.EnDescription)</p>
            </article>
        }
    </div>
</section>

<section id="demo" class="scanner-section">
    <div class="scanner-copy">
        <span class="section-kicker">@L("在线体验", "Live demo")</span>
        <h2>@L("用当前设备试一下", "Try it on this device")</h2>
        <p>@L("摄像头数据只在浏览器本地处理，不会上传到服务器。",
             "Camera frames are processed locally in your browser and aren't uploaded to a server.")</p>

        <div class="demo-options">
            <label>
                <input type="checkbox" @bind="DecodeContinuously" />
                <span>@L("连续解码", "Continuous decoding")</span>
            </label>
            <label>
                <input type="checkbox" @bind="CaptureStillOnScan" />
                <span>@L("扫码成功时截图", "Capture frame on scan")</span>
            </label>
        </div>

        <button class="btn btn-primary btn-lg" type="button" @onclick="ToggleScanner">
            <span class="oi oi-camera-slr" aria-hidden="true"></span>
            @(ShowScanner ? L("关闭扫码器", "Close scanner") : L("打开扫码器", "Open scanner"))
        </button>
    </div>

    <div class="result-panel">
        <span class="result-label">@L("最近结果", "Latest result")</span>
        @if (string.IsNullOrWhiteSpace(ScanText))
        {
            <p class="empty-result">@L("扫码结果会显示在这里", "Your scan result will appear here")</p>
        }
        else
        {
            <pre>@ScanText</pre>
        }

        @if (!string.IsNullOrWhiteSpace(CapturedImageDataUrl))
        {
            <img src="@CapturedImageDataUrl" alt="@L("扫码时捕获的画面", "Captured barcode frame")" />
        }
    </div>
</section>

@if (ShowScanner)
{
    <BarcodeReader ScanResult="OnScanResult"
                   ScanCaptured="OnScanCaptured"
                   Close="CloseScanner"
                   OnError="OnError"
                   ScanBtnTitle="@L("扫码", "Scan")"
                   ResetBtnTitle="@L("重置", "Reset")"
                   CloseBtnTitle="@L("关闭", "Close")"
                   SelectDeviceBtnTitle="@L("选择设备", "Select device")"
                   Decodeonce="!DecodeContinuously"
                   CaptureStillOnScan="CaptureStillOnScan"
                   CaptureStillAutoResumeDelay="2500" />
}

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@ErrorMessage</div>
}

<section id="quick-start" class="content-section quick-start">
    <div class="section-intro">
        <span class="section-kicker">@L("快速上手", "Quick start")</span>
        <h2>@L("三步开始扫码", "Start scanning in three steps")</h2>
        <p>@L("组件使用 JavaScript 隔离，不需要在页面中手动添加脚本。",
             "The component uses JavaScript isolation, so no script tags are required.")</p>
    </div>

    <div class="steps">
        <article>
            <span>1</span>
            <div>
                <h3>@L("安装 NuGet 包", "Install the NuGet package")</h3>
                <pre><code>dotnet add package ZXingBlazor</code></pre>
            </div>
        </article>
        <article>
            <span>2</span>
            <div>
                <h3>@L("导入组件命名空间", "Import the component namespace")</h3>
                <pre><code>@@using ZXingBlazor.Components</code></pre>
            </div>
        </article>
        <article>
            <span>3</span>
            <div>
                <h3>@L("添加组件和回调", "Add the component and callback")</h3>
                <pre><code>@BasicUsage</code></pre>
            </div>
        </article>
    </div>

    <div class="https-note">
        <span class="oi oi-lock-locked" aria-hidden="true"></span>
        <div>
            <strong>@L("摄像头需要安全上下文", "Camera access requires a secure context")</strong>
            <p>@L("生产环境请使用 HTTPS；本地开发可使用 localhost。",
                 "Use HTTPS in production. Localhost is supported during development.")</p>
        </div>
    </div>
</section>

<section class="content-section">
    <div class="section-intro">
        <span class="section-kicker">@L("组件接口", "Component API")</span>
        <h2>@L("简单回调，完整结果", "Simple callbacks, complete results")</h2>
    </div>
    <div class="callback-grid">
        @foreach (var callback in Callbacks)
        {
            <article>
                <code>@callback.Name</code>
                <p>@L(callback.Zh, callback.En)</p>
            </article>
        }
    </div>
</section>

<section class="closing-section">
    <div>
        <span class="section-kicker">@L("开源 · MIT", "Open source · MIT")</span>
        <h2>@L("准备好在你的 Blazor 应用中扫码了吗？", "Ready to scan in your Blazor app?")</h2>
    </div>
    <div class="closing-actions">
        <a class="btn btn-primary" href="https://www.nuget.org/packages/ZXingBlazor/" target="_blank" rel="noopener noreferrer">NuGet</a>
        <a class="btn btn-outline-secondary" href="https://github.com/densen2014/ZXingBlazor" target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
</section>

<footer>ZXingBlazor @VersionText · @L(".NET 10 示例站点", ".NET 10 demo site")</footer>

@code {
    private readonly record struct Feature(
        string Icon,
        string ZhTitle,
        string EnTitle,
        string ZhDescription,
        string EnDescription);

    private readonly record struct Callback(string Name, string Zh, string En);

    private static readonly Feature[] Features =
    [
        new("oi-camera-slr", "浏览器摄像头", "Browser camera", "直接调用手机或桌面摄像头，支持设备选择与记忆。", "Use mobile and desktop cameras with device selection and persistence."),
        new("oi-grid-three-up", "多格式识别", "Multiple formats", "支持 QR Code、Data Matrix、PDF417 及常见一维码。", "Decode QR Code, Data Matrix, PDF417, and common 1D formats."),
        new("oi-loop-circular", "连续与单次解码", "Continuous or one-shot", "按业务场景选择单次返回或持续读取多个条码。", "Choose a single result or continuously read multiple barcodes."),
        new("oi-contrast", "反色条码", "Inverted barcodes", "同一摄像头流同时识别普通与黑底白码，避免设备争用。", "Recognize regular and white-on-black codes on one camera stream."),
        new("oi-image", "扫码截图", "Scan-frame capture", "扫码成功时冻结画面，并通过流式互操作返回 JPEG。", "Freeze successful scans and return a JPEG through streaming interop."),
        new("oi-code", "可定制界面", "Customizable UI", "使用内置界面快速接入，或通过 data-action 构建自定义体验。", "Start with the built-in UI or create a custom experience with data-action controls.")
    ];

    private static readonly Callback[] Callbacks =
    [
        new("ScanResult", "返回解码后的文本。", "Returns the decoded text."),
        new("ScanCaptured", "返回文本和扫码时捕获的 JPEG Data URL。", "Returns text and a JPEG data URL captured at scan time."),
        new("Close", "用户关闭扫码界面时触发。", "Raised when the scanner is closed."),
        new("OnError", "返回摄像头、解码器或互操作错误。", "Reports camera, decoder, or interop errors.")
    ];

    private const string BasicUsage = """
<BarcodeReader ScanResult="text => result = text" />

@code {
    private string? result;
}
""";

    private bool IsEnglish;
    private bool ShowScanner;
    private bool DecodeContinuously;
    private bool CaptureStillOnScan;
    private string ScanText = string.Empty;
    private string? CapturedImageDataUrl;
    private string? ErrorMessage;

    private string VersionText =>
        typeof(BarcodeReader).Assembly.GetName().Version?.ToString(3) ?? string.Empty;

    protected override void OnInitialized()
    {
        IsEnglish = string.Equals(
            NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0].Trim('/'),
            "en",
            StringComparison.OrdinalIgnoreCase);
    }

    private string L(string zh, string en) => IsEnglish ? en : zh;

    private void ToggleLanguage() => IsEnglish = !IsEnglish;

    private void ToggleScanner()
    {
        ShowScanner = !ShowScanner;
        ErrorMessage = null;
        if (ShowScanner)
        {
            ScanText = string.Empty;
            CapturedImageDataUrl = null;
        }
    }

    private void CloseScanner() => ShowScanner = false;

    private void OnScanResult(string text)
    {
        if (DecodeContinuously)
        {
            ScanText = ScanText.Length > 500
                ? text
                : ScanText + text + Environment.NewLine;
            return;
        }

        ScanText = text;
        ShowScanner = false;
    }

    private void OnScanCaptured(ScanCapturedEventArgs args)
    {
        ScanText = args.Text;
        CapturedImageDataUrl = args.ImageDataUrl;
    }

    private Task OnError(string message)
    {
        ErrorMessage = message;
        return Task.CompletedTask;
    }
}
