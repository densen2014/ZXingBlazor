<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.*" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.*" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\src\ZXingBlazor\ZXingBlazor.csproj" />
    </ItemGroup>

    <Target Name="CreateStandaloneRuntimeAlias" AfterTargets="Publish">
        <ItemGroup>
            <_DotNetRuntimeScript Include="$(PublishDir)wwwroot\_framework\dotnet.*.js"
                                  Exclude="$(PublishDir)wwwroot\_framework\dotnet.native.*.js;$(PublishDir)wwwroot\_framework\dotnet.runtime.*.js" />
        </ItemGroup>
        <Error Condition="'@(_DotNetRuntimeScript)' == ''"
               Text="The fingerprinted dotnet.js runtime asset was not found." />
        <Copy SourceFiles="@(_DotNetRuntimeScript)"
              DestinationFiles="@(_DotNetRuntimeScript->'$(PublishDir)wwwroot\_framework\dotnet.js')" />
    </Target>

</Project>
